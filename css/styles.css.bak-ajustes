/* ArandaCrafts — Estilos base */

* { box-sizing: border-box; }

html, body { margin: 0; padding: 0; height: 100%; }

body {
  font-family: var(--font-base);
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  line-height: 1.45;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* TOPBAR */
.topbar {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1.25rem;
  background: var(--bg-elev);
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 100;
}
.topbar-left { flex-shrink: 0; }
.logo { font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; }
.topbar-nav { display: flex; gap: 0.25rem; flex: 1; }
.topbar-right { flex-shrink: 0; }

.nav-btn {
  background: transparent;
  border: none;
  padding: 0.45rem 0.85rem;
  border-radius: var(--radius-sm);
  color: var(--text-soft);
  font: inherit;
  font-weight: 500;
  cursor: pointer;
  transition: background .12s, color .12s;
}
.nav-btn:hover { background: var(--bg-soft); color: var(--text); }
.nav-btn.activa { background: var(--primary-soft); color: var(--primary); font-weight: 600; }

.icon-btn {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  width: 36px;
  height: 36px;
  font-size: 1rem;
  cursor: pointer;
  color: var(--text-soft);
  transition: background .12s, color .12s;
}
.icon-btn:hover { background: var(--bg-soft); color: var(--text); }

/* CONTENIDO */
.contenido {
  flex: 1;
  padding: 1.5rem 1.25rem 3rem;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
}
.vista { display: none; }
.vista.activa { display: block; }

h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 1rem; letter-spacing: -0.01em; }
h2 { font-size: 1.1rem; font-weight: 600; margin: 1.25rem 0 0.5rem; }

.placeholder {
  color: var(--text-mute);
  font-style: italic;
  padding: 1rem;
  background: var(--bg-soft);
  border-radius: var(--radius);
  border: 1px dashed var(--border);
}

/* TABS */
.tabs {
  display: flex;
  gap: 0.25rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}
.tab {
  background: transparent;
  border: none;
  padding: 0.6rem 1rem;
  color: var(--text-soft);
  font: inherit;
  font-weight: 500;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  transition: color .12s, border-color .12s;
}
.tab:hover { color: var(--text); }
.tab.activa { color: var(--primary); border-bottom-color: var(--primary); font-weight: 600; }
.tab-panel { display: none; }
.tab-panel.activa { display: block; }

/* STATUS BAR */
.statusbar {
  padding: 0.5rem 1.25rem;
  background: var(--bg-elev);
  border-top: 1px solid var(--border);
  color: var(--text-mute);
  font-size: 0.8rem;
  text-align: center;
}

/* BOTONES */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 0.95rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--bg-elev);
  color: var(--text);
  font: inherit;
  font-weight: 500;
  cursor: pointer;
  transition: background .12s, border-color .12s, color .12s;
}
.btn:hover { background: var(--bg-soft); }
.btn-primario { background: var(--primary); border-color: var(--primary); color: #fff; }
.btn-primario:hover { background: var(--primary-hover); border-color: var(--primary-hover); }
.btn-peligro { background: var(--danger-soft); border-color: transparent; color: var(--danger); }
.btn-peligro:hover { background: var(--danger); color: #fff; }
.btn-sm { padding: 0.3rem 0.6rem; font-size: 0.85rem; }

/* FORMULARIOS */
input, select, textarea {
  font: inherit;
  color: var(--text);
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.45rem 0.6rem;
  width: 100%;
  transition: border-color .12s, box-shadow .12s;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-soft);
}
label {
  display: block;
  font-size: 0.85rem;
  color: var(--text-soft);
  margin-bottom: 0.25rem;
  font-weight: 500;
}
.campo { margin-bottom: 0.85rem; }

/* TARJETAS */
.card {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
  box-shadow: var(--shadow-sm);
  margin-bottom: 1rem;
}

/* TABLAS */
.tabla {
  width: 100%;
  border-collapse: collapse;
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.tabla th, .tabla td {
  padding: 0.6rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
  font-size: 0.92rem;
}
.tabla th {
  background: var(--bg-soft);
  font-weight: 600;
  color: var(--text-soft);
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.tabla tr:last-child td { border-bottom: none; }
.tabla tbody tr:hover { background: var(--bg-soft); }

/* UTILIDADES */
.fila { display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap; }
.fila > * { flex: 1; min-width: 120px; }
.derecha { text-align: right; }
.centro  { text-align: center; }
.mono    { font-variant-numeric: tabular-nums; }
.acciones { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem; }

@media (max-width: 640px) {
  .topbar { flex-wrap: wrap; gap: 0.5rem; padding: 0.6rem 0.9rem; }
  .topbar-nav { order: 3; width: 100%; overflow-x: auto; }
  .contenido { padding: 1rem 0.9rem 2rem; }
}

/* ═══════════ CATÁLOGO — tabla editable ═══════════ */

.barra-acciones {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

.tabla-edit input {
  border: 1px solid transparent;
  background: transparent;
  padding: 0.35rem 0.5rem;
  width: 100%;
  border-radius: var(--radius-sm);
  font: inherit;
  color: var(--text);
}
.tabla-edit input:hover { border-color: var(--border); }
.tabla-edit input:focus {
  outline: none;
  border-color: var(--primary);
  background: var(--bg-elev);
  box-shadow: 0 0 0 3px var(--primary-soft);
}
.tabla-edit input.num { text-align: right; font-variant-numeric: tabular-nums; }

.tabla-edit .acciones-fila {
  display: flex;
  justify-content: center;
  gap: 0.25rem;
}

.hint {
  font-size: 0.82rem;
  color: var(--text-mute);
  margin-top: 0.5rem;
}

/* Select editable en tabla (unidades) */
.tabla-edit select {
  border: 1px solid transparent;
  background: transparent;
  padding: 0.35rem 0.5rem;
  width: 100%;
  border-radius: var(--radius-sm);
  font: inherit;
  color: var(--text);
  cursor: pointer;
}
.tabla-edit select:hover { border-color: var(--border); }
.tabla-edit select:focus {
  outline: none;
  border-color: var(--primary);
  background: var(--bg-elev);
  box-shadow: 0 0 0 3px var(--primary-soft);
}

/* ═══════════ PRESUPUESTOS — Editor ═══════════ */

.bloque-lineas { padding: 0.9rem 1rem; }
.bloque-cabecera {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.6rem;
}
.bloque-cabecera h2 { margin: 0; font-size: 1rem; }

.tabla-lineas input,
.tabla-lineas select {
  border: 1px solid transparent;
  background: transparent;
  padding: 0.35rem 0.5rem;
  width: 100%;
  border-radius: var(--radius-sm);
  font: inherit;
  color: var(--text);
}
.tabla-lineas input:hover,
.tabla-lineas select:hover { border-color: var(--border); }
.tabla-lineas input:focus,
.tabla-lineas select:focus {
  outline: none;
  border-color: var(--primary);
  background: var(--bg-elev);
  box-shadow: 0 0 0 3px var(--primary-soft);
}
.tabla-lineas input.num { text-align: right; font-variant-numeric: tabular-nums; }

.total-card { padding: 0.9rem 1rem; }
.total-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  padding-left: 1rem;
  border-left: 2px solid var(--border);
  min-width: 180px;
}
.total-label { font-size: 0.8rem; letter-spacing: 0.05em; color: var(--text-soft); }
.total-valor {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

/* Selector de catálogo inline (datalist fallback: usamos input con list) */
.tabla-lineas input[list] { padding-right: 1.2rem; }

@media (max-width: 720px) {
  .total-box { border-left: none; border-top: 2px solid var(--border); padding-left: 0; padding-top: 0.6rem; align-items: flex-start; }
}

/* Subcategorías del catálogo (acordeón) */
.subcat {
  margin-bottom: 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-elev);
  overflow: hidden;
}
.subcat > summary {
  padding: 0.75rem 1rem;
  cursor: pointer;
  font-weight: 600;
  font-size: 1rem;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--bg-soft);
  transition: background .12s;
}
.subcat > summary:hover { background: var(--border); }
.subcat > summary::-webkit-details-marker { display: none; }
.subcat > summary::before {
  content: '▸';
  display: inline-block;
  transition: transform .15s;
  font-size: 0.8rem;
}
.subcat[open] > summary::before { transform: rotate(90deg); }

.subcat-body {
  padding: 0.75rem 1rem 1rem;
}
.subcat-body .btn-sm { margin-bottom: 0.6rem; }

/* ═══════════ MODAL: Selector de catálogo ═══════════ */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
}
.modal-overlay[hidden] { display: none; }

.modal-caja {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  width: 100%;
  max-width: 560px;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-cabecera {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--border);
}
.modal-cabecera h3 { margin: 0; font-size: 1.05rem; font-weight: 600; }
.modal-cerrar {
  background: transparent; border: none; cursor: pointer;
  font-size: 1.1rem; color: var(--text-soft); padding: 0.25rem 0.5rem;
  border-radius: var(--radius-sm);
}
.modal-cerrar:hover { background: var(--bg-soft); color: var(--text); }

.modal-tabs {
  display: flex;
  gap: 0.25rem;
  padding: 0.5rem 0.75rem 0;
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
}
.mtab {
  background: transparent;
  border: none;
  padding: 0.5rem 0.75rem;
  font: inherit;
  font-size: 0.9rem;
  color: var(--text-soft);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
  margin-bottom: -1px;
}
.mtab:hover { color: var(--text); }
.mtab.activa { color: var(--primary); border-bottom-color: var(--primary); font-weight: 600; }

.modal-buscador {
  padding: 0.75rem 1rem 0.5rem;
}
.modal-buscador input {
  width: 100%;
}

.modal-lista {
  list-style: none;
  margin: 0;
  padding: 0 0.5rem 1rem;
  overflow-y: auto;
  flex: 1;
}
.modal-lista li {
  padding: 0.6rem 0.75rem;
  border-radius: var(--radius-sm);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}
.modal-lista li:hover { background: var(--primary-soft); }
.modal-lista li .nombre { flex: 1; }
.modal-lista li .precio {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
}
.modal-lista li .unidad {
  font-size: 0.78rem;
  color: var(--text-soft);
  background: var(--bg-soft);
  padding: 0.1rem 0.4rem;
  border-radius: var(--radius-sm);
  margin-left: 0.5rem;
}
.modal-lista .vacio {
  text-align: center;
  color: var(--text-mute);
  font-style: italic;
  padding: 1.5rem 0.75rem;
  cursor: default;
}
.modal-lista .vacio:hover { background: transparent; }

/* ═══════════ INICIO (dashboard) ═══════════ */

.inicio-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 1rem;
  align-items: start;
}
@media (max-width: 860px) {
  .inicio-grid { grid-template-columns: 1fr; }
}

.inicio-resumen { padding: 1.1rem 1.2rem; }
.resumen-bloque {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0.5rem 0;
}
.resumen-bloque + .resumen-bloque { border-top: 1px solid var(--border); }
.resumen-label {
  font-size: 0.85rem;
  color: var(--text-soft);
}
.resumen-valor {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

.inicio-acciones {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1rem 1.2rem;
}
.btn-lg { padding: 0.7rem 1rem; font-size: 1rem; justify-content: center; }

.inicio-cabecera-lista {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.6rem;
}
.inicio-cabecera-lista h2 { margin: 0; font-size: 1.05rem; }

#inicio-tbody tr { cursor: pointer; }
#inicio-tbody tr:hover { background: var(--primary-soft); }
