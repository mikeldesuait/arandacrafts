/* ArandaCrafts — Estilos de impresión
   Solo se aplican al imprimir (@media print). En pantalla, el documento
   se ve normal; en la impresión, se oculta la UI y se muestra #print-area.
*/

@media print {

  /* 1) Ocultar toda la UI */
  body > *:not(#print-area) {
    display: none !important;
  }

  /* 2) Mostrar solo la zona de impresión */
  #print-area {
    display: block !important;
    padding: 2cm 1.5cm;
    font-family: 'Inter', system-ui, sans-serif;
    color: #000;
    background: #fff;
    font-size: 11pt;
    line-height: 1.4;
  }

  /* 3) Cabecera: emisor + datos del documento */
  #print-area .pr-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    border-bottom: 2px solid #000;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
  #print-area .pr-emisor h1 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }
  #print-area .pr-emisor div { font-size: 0.9rem; color: #333; }

  #print-area .pr-doc { text-align: right; white-space: nowrap; }
  #print-area .pr-tipo { font-size: 0.85rem; letter-spacing: 0.1em; color: #555; }
  #print-area .pr-num { font-size: 1.3rem; font-weight: 700; margin: 0.1rem 0 0.3rem; }
  #print-area .pr-fecha { font-size: 0.9rem; }

  /* 4) Cliente */
  #print-area .pr-cliente {
    background: #f4f4f4;
    padding: 0.7rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  /* 5) Tabla */
  #print-area .pr-tabla {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  #print-area .pr-tabla th,
  #print-area .pr-tabla td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid #ccc;
    text-align: left;
    vertical-align: top;
  }
  #print-area .pr-tabla th {
    background: #222;
    color: #fff;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: none;
  }
  #print-area .pr-tabla th.num,
  #print-area .pr-tabla td.num { text-align: right; font-variant-numeric: tabular-nums; }

  #print-area .pr-tabla tr.fila-grupo td {
    background: #eee;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    border-bottom: 1px solid #999;
  }

  #print-area .pr-tabla small {
    font-size: 0.8rem;
    color: #666;
  }

  /* 6) Total */
  #print-area .pr-total {
    text-align: right;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0.5rem 0 1.5rem;
    padding-top: 0.6rem;
    border-top: 2px solid #000;
  }

  /* 7) Notas y pie */
  #print-area .pr-notas {
    font-size: 0.9rem;
    background: #f9f9f9;
    padding: 0.6rem 0.9rem;
    border-left: 3px solid #999;
    margin-bottom: 1rem;
  }
  #print-area .pr-pie {
    font-size: 0.75rem;
    color: #666;
    text-align: center;
    border-top: 1px solid #ccc;
    padding-top: 0.6rem;
    margin-top: 1.5rem;
  }

  /* 8) Sin saltos de página dentro de bloques pequeños */
  #print-area table,
  #print-area .pr-total { page-break-inside: avoid; }

  /* 9) Ajustes de página */
  @page {
    margin: 1cm;
    size: A4 portrait;
  }
}
