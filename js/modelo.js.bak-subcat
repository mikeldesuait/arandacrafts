/* ArandaCrafts — Modelo de datos y catálogo inicial
   v2 (simplificado): 2 catálogos → materiales + mano de obra
*/

window.Modelo = (function () {
  'use strict';

  // ── Claves de almacenamiento ───────────────────────
  var K = {
    materiales:   'catalogo:materiales',
    mano:         'catalogo:mano',
    presupuestos: 'presupuestos',
    emisor:       'emisor',
    contador:     'contador'
  };

  // Claves antiguas (para migración)
  var K_OLD = {
    prendas:     'catalogo:prendas',
    estampacion: 'catalogo:estampacion'
  };

  // ── Catálogo inicial ───────────────────────────────

  var MATERIALES_INICIALES = [
    // Prendas (ud)
    { nombre: 'Camiseta básica (algodón 150g)',  unidad: 'ud',      precio: 3.50 },
    { nombre: 'Camiseta premium (algodón 190g)', unidad: 'ud',      precio: 5.20 },
    { nombre: 'Camiseta manga larga',            unidad: 'ud',      precio: 7.50 },
    { nombre: 'Sudadera con capucha',            unidad: 'ud',      precio: 14.00 },
    { nombre: 'Sudadera sin capucha',            unidad: 'ud',      precio: 12.00 },
    { nombre: 'Polo',                            unidad: 'ud',      precio: 8.50 },
    { nombre: 'Bolsa tote',                      unidad: 'ud',      precio: 2.80 },
    { nombre: 'Taza blanca',                     unidad: 'ud',      precio: 2.50 },
    { nombre: 'Gorra',                           unidad: 'ud',      precio: 4.00 },
    { nombre: 'Babero',                          unidad: 'ud',      precio: 2.20 },
    // Vinilo (metro)
    { nombre: 'Vinilo textil color',             unidad: 'metro',   precio: 6.00 },
    { nombre: 'Vinilo textil reflectante',       unidad: 'metro',   precio: 12.00 },
    { nombre: 'Vinilo textil purpurina',         unidad: 'metro',   precio: 9.00 },
    { nombre: 'Vinilo textil flock',             unidad: 'metro',   precio: 8.50 },
    // DTF (plancha)
    { nombre: 'Plancha DTF A5',                  unidad: 'plancha', precio: 1.50 },
    { nombre: 'Plancha DTF A4',                  unidad: 'plancha', precio: 2.20 },
    { nombre: 'Plancha DTF A3',                  unidad: 'plancha', precio: 3.80 },
    // Otras técnicas (ud)
    { nombre: 'Serigrafía 1 color 1 cara',       unidad: 'ud',      precio: 1.20 },
    { nombre: 'Serigrafía 2 colores',            unidad: 'ud',      precio: 1.80 },
    { nombre: 'Sublimación taza',                unidad: 'ud',      precio: 1.50 }
  ];

  var MANO_INICIAL = [
    { nombre: 'Diseño personalizado',    tipo: 'hora',   precio: 25.00 },
    { nombre: 'Preparación de archivos', tipo: 'fijo',   precio: 5.00 },
    { nombre: 'Colocación y planchado',  tipo: 'unidad', precio: 0.80 },
    { nombre: 'Packaging individual',    tipo: 'unidad', precio: 0.50 },
    { nombre: 'Envío península',         tipo: 'fijo',   precio: 5.90 },
    { nombre: 'Envío Baleares',          tipo: 'fijo',   precio: 8.50 }
  ];

  // ── Utilidades ─────────────────────────────────────

  function conId(lista) {
    return lista.map(function (item) {
      return Object.assign({ id: window.Storage.uuid() }, item);
    });
  }

  function cargarLista(clave, defectoInicial) {
    var datos = window.Storage.get(clave, null);
    if (!datos) {
      datos = conId(defectoInicial);
      window.Storage.set(clave, datos);
    }
    return datos;
  }

  // ── Migración desde esquema antiguo (prendas + estampacion) ──

  function migrarSiHaceFalta() {
    var yaMateriales = window.Storage.get(K.materiales, null);
    if (yaMateriales) return; // ya migrado o catálogo nuevo

    var prendas     = window.Storage.get(K_OLD.prendas, null);
    var estampacion = window.Storage.get(K_OLD.estampacion, null);

    if (!prendas && !estampacion) return; // nada antiguo que migrar

    var fusion = [];

    (prendas || []).forEach(function (p) {
      fusion.push({
        id:     p.id || window.Storage.uuid(),
        nombre: p.nombre,
        unidad: 'ud',
        precio: p.precio || 0
      });
    });

    (estampacion || []).forEach(function (e) {
      fusion.push({
        id:     e.id || window.Storage.uuid(),
        nombre: e.nombre,
        unidad: e.unidad || 'ud',
        precio: e.precio || 0
      });
    });

    window.Storage.set(K.materiales, fusion);
    window.Storage.del(K_OLD.prendas);
    window.Storage.del(K_OLD.estampacion);
    console.log('[ArandaCrafts] Catálogo migrado a "materiales":', fusion.length, 'ítems.');
  }

  // ── API pública ────────────────────────────────────

  function getMateriales()      { return cargarLista(K.materiales, MATERIALES_INICIALES); }
  function setMateriales(l)     { window.Storage.set(K.materiales, l); }

  function getMano()            { return cargarLista(K.mano, MANO_INICIAL); }
  function setMano(l)           { window.Storage.set(K.mano, l); }

  function getPresupuestos()      { return window.Storage.get(K.presupuestos, []); }
  function setPresupuestos(lista) { window.Storage.set(K.presupuestos, lista); }

  function getEmisor() {
    return window.Storage.get(K.emisor, {
      nombre: 'ArandaCrafts',
      nif: '', direccion: '', telefono: '', email: ''
    });
  }
  function setEmisor(e) { window.Storage.set(K.emisor, e); }

  // ── Numeración correlativa por año ─────────────────

  function siguienteNumero() {
    var año = new Date().getFullYear();
    var cont = window.Storage.get(K.contador, {});
    var actual = cont[año] || 0;
    var siguiente = actual + 1;
    cont[año] = siguiente;
    window.Storage.set(K.contador, cont);
    return año + '-' + String(siguiente).padStart(3, '0');
  }

  // ── Cálculos ───────────────────────────────────────

  function subtotalLinea(linea) {
    var c = parseFloat(linea.cantidad) || 0;
    var p = parseFloat(linea.precio) || 0;
    return Math.round(c * p * 100) / 100;
  }

  function totalPresupuesto(presupuesto) {
    if (!presupuesto || !presupuesto.lineas) return 0;
    var t = presupuesto.lineas.reduce(function (acc, l) {
      return acc + subtotalLinea(l);
    }, 0);
    return Math.round(t * 100) / 100;
  }

  // ── Init ───────────────────────────────────────────

  function init() {
    migrarSiHaceFalta();
    var m = getMateriales();
    var o = getMano();
    console.log('[ArandaCrafts] Catálogo →',
      m.length + ' materiales, ' + o.length + ' mano de obra / extras.');
  }

  return {
    init: init,
    getMateriales: getMateriales, setMateriales: setMateriales,
    getMano: getMano,             setMano: setMano,
    getPresupuestos: getPresupuestos, setPresupuestos: setPresupuestos,
    getEmisor: getEmisor,         setEmisor: setEmisor,
    siguienteNumero: siguienteNumero,
    subtotalLinea: subtotalLinea,
    totalPresupuesto: totalPresupuesto
  };
})();
