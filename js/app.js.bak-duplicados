  var presuActual = null;   // objeto en edición (null = nuevo)

  // ── Utilidades ──────────────────────────────────────

  function eur(n) {
    var v = parseFloat(n) || 0;
    return v.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }

  function totalLineas() {
    var t = 0;
    document.querySelectorAll('.tabla-lineas tbody tr').forEach(function (tr) {
      var c = parseFloat(tr.querySelector('.inp-cantidad')?.value) || 0;
      var p = parseFloat(tr.querySelector('.inp-precio')?.value) || 0;
      t += c * p;
    });
    return Math.round(t * 100) / 100;
  }

  function actualizarTotalPresu() {
    var el = document.getElementById('presu-total');
    if (el) el.textContent = eur(totalLineas());
  }

  // ── Fila de línea (según tipo) ──────────────────────

  function crearFilaLinea(grupo, datos) {
    datos = datos || {};
    var tr = document.createElement('tr');
    tr.dataset.grupo = grupo;

    var concepto = datos.concepto || '';
    var cantidad = (datos.cantidad != null) ? datos.cantidad : 1;
    var precio   = (datos.precio != null) ? datos.precio : 0;
    var unidad   = datos.unidad || '';
    var tipo     = datos.tipo   || '';
    var idRef    = datos.idRef  || '';

    var html = '';
    html += '<td><input type="text" class="inp-concepto" value="' + escapar(concepto) + '" placeholder="Concepto..."></td>';
    html += '<td><input type="number" step="0.01" min="0" class="inp-cantidad num" value="' + cantidad + '"></td>';

    if (grupo === 'material') {
      var u = (unidad || 'ud');
      html += '<td><input type="text" class="inp-unidad" value="' + escapar(u) + '"></td>';
    }
    if (grupo === 'mano') {
      var t = (tipo || 'unidad');
      html += '<td><input type="text" class="inp-tipo" value="' + escapar(t) + '"></td>';
    }

    html += '<td><input type="number" step="0.01" min="0" class="inp-precio num" value="' + precio + '"></td>';
    html += '<td class="derecha subtotal mono">0,00 €</td>';
    html += '<td class="centro"><button class="btn btn-sm btn-peligro btn-borrar-linea" title="Eliminar">🗑️</button></td>';

    tr.innerHTML = html;
    tr.dataset.idRef = idRef;

    // Eventos de recálculo
    tr.querySelectorAll('input').forEach(function (inp) {
      inp.addEventListener('input', function () {
        recalcularFila(tr);
        actualizarTotalPresu();
      });
    });
    tr.querySelector('.btn-borrar-linea').addEventListener('click', function () {
      tr.remove();
      actualizarTotalPresu();
    });

    recalcularFila(tr);
    return tr;
  }

  function recalcularFila(tr) {
    var c = parseFloat(tr.querySelector('.inp-cantidad').value) || 0;
    var p = parseFloat(tr.querySelector('.inp-precio').value) || 0;
    var sub = Math.round(c * p * 100) / 100;
    tr.querySelector('.subtotal').textContent = eur(sub);
  }

  // ── Añadir línea desde el catálogo (con prompt simple) ──

  function elegirDelCatalogo(tipo) {
    var lista = [];
    if (tipo === 'ropa')       lista = window.Modelo.getRopa();
    if (tipo === 'material')   lista = window.Modelo.getMateriales();
    if (tipo === 'mano')       lista = window.Modelo.getMano();

    if (!lista.length) {
      alert('El catálogo está vacío. Añade primero en Catálogo.');
      return null;
    }

    // Menú textual: 1) Nombre — precio unidad
    var txt = 'Elige un elemento del catálogo (número):\n\n';
    lista.forEach(function (it, i) {
      var extra = '';
      if (tipo === 'material') extra = ' (' + (it.unidad || 'ud') + ')';
      if (tipo === 'mano')     extra = ' (' + (it.tipo || 'unidad') + ')';
      txt += (i + 1) + ') ' + it.nombre + ' — ' + eur(it.precio) + extra + '\n';
    });

    var resp = prompt(txt, '1');
    if (!resp) return null;
    var idx = parseInt(resp, 10) - 1;
    if (isNaN(idx) || !lista[idx]) return null;
    return lista[idx];
  }

  function anadirLineaDesdeCatalogo(grupo) {
    var item = elegirDelCatalogo(grupo);
    if (!item) return;

    var datos = {
      idRef:    item.id,
      concepto: item.nombre,
      cantidad: 1,
      precio:   item.precio
    };
    if (grupo === 'material') datos.unidad = item.unidad || 'ud';
    if (grupo === 'mano')    datos.tipo   = item.tipo   || 'unidad';

    var tbodyId = 'lineas-' + grupo;
    var tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    tbody.appendChild(crearFilaLinea(grupo, datos));
    actualizarTotalPresu();
  }

